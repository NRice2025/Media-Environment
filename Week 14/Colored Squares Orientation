function setup() {
  createCanvas(800, 600);
  rectMode(CENTER);
  noStroke();
  angleMode(DEGREES);
}

function draw() {
  background(220);
  
  push()
  translate(width/2, height/2)
  rotate(45)
  fill(100,0,50)
  rect(0, 0, 160, 160)
  pop()
  
  push()
  translate(width/2/2, height/2/2)
  rotate(20)
  fill(0,80,100)
  rect(0, 0, 80, 80)
  pop()
  
  rectC(100, 100, 50, 50, 125, 65, 100, 0)
}

function rectC (x, y, w, h, rotation, r, g, b){
  push()
  translate(x,y);
  rotate(rotation);
  fill(r, g, b);
  rect(0,0, w, h);
  pop()
}