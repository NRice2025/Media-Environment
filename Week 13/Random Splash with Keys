var pressed = false;

function setup() {
  createCanvas(800, 600);
  background(0);
  noStroke();
}

function draw() {
  if (pressed === true){
    fill(random(1,255), random(1,255), random(1,255), random(1,255));
    circle(random(width), random(height), random(10,100));
  }
  pressed = false;
}

function keyPressed(){
  pressed = true;
}