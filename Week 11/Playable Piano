function black2(shift) {
  var keyW = width/14-5;
  var blackH = 200;
  offset = 30;
  for (var i = 0; i < 2; i++)
    {
      fill(0);
      rect(offset*shift+(i*keyW), offset, keyW*(2/3), blackH, 0, 0, 20, 20);
    }
}

function black3(shift) {
  var keyW = width/14-5;
  var blackH = 200;
  offset = 30;
  for (var i = 0; i < 3; i++)
    {
      fill(0);
      rect(offset*shift+(i*keyW), offset, keyW*(2/3), blackH, 0, 0, 20, 20);
    }
}

function keyReleased()
{
  osc.amp(0, 0.5)
}

function Key() {
  this.butt = 81
  this.freq = 261.6256
  
  this.x = 63
  this.y = 284
  
  this.press = function() {  
    if (keyIsDown(this.butt))
    {
      osc.start();
      osc.freq(this.freq);
      osc.amp(1000, 0.05);
      
      fill(0, 255, 0);
      ellipse(this.x, this.y, 50, 50);
    }
  }
}